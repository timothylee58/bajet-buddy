# Copy to apps/web/.env.local and apps/api/.env — never commit real secrets.

# ── Web (apps/web/.env.local) ──
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional — "Split with Bayar.lah" button on /transactions is hidden until set
NEXT_PUBLIC_BAYARLAH_URL=
# Optional — same Sentry DSN as SENTRY_DSN below (shared project, both apps)
NEXT_PUBLIC_SENTRY_DSN=

# ── API (apps/api/.env) ──
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
ILMU_API_KEY=your-ilmu-key
ILMU_ANTHROPIC_BASE_URL=https://api.ilmu.ai/anthropic
ILMU_MODEL=nemo-super
ANTHROPIC_API_KEY=optional-fallback-anthropic-key
REDIS_URL=redis://localhost:6379
SECRET_KEY=change-me-in-production
ENVIRONMENT=development
ALLOWED_ORIGINS=["http://localhost:3000"]
# Optional — error/perf monitoring; leave unset locally to avoid noisy dev events
SENTRY_DSN=
